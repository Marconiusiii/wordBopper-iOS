    "Feel the Bop more with subtle game event vibrations." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spüre das Bop intensiver mit dezenten Vibrationen bei Spielereignissen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente más el Bop con sutiles vibraciones en los eventos del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressentez davantage le Bop grâce à de subtiles vibrations lors des événements du jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti di più il Bop con sottili vibrazioni durante gli eventi di gioco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel de Bop sterker met subtiele trillingen bij spelgebeurtenissen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta mais o Bop com vibrações sutis nos eventos do jogo."
          }
        }
      }
    },
    "For an extra challenge, BopAway instantly moves each tapped letter into the word tray and replaces it with a new letter. If you clear the word, those letters are lost. Bop wisely!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine zusätzliche Herausforderung verschiebt BopAway jeden angetippten Buchstaben sofort ins Wortfach und ersetzt ihn durch einen neuen. Wenn du das Wort löschst, sind diese Buchstaben verloren. Bop mit Bedacht!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un reto extra, BopAway mueve al instante cada letra tocada a la bandeja de palabras y la reemplaza por una nueva. Si borras la palabra, esas letras se pierden. ¡Bopea con cabeza!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un défi supplémentaire, BopAway déplace instantanément chaque lettre touchée vers le plateau de mots et la remplace par une nouvelle. Si vous effacez le mot, ces lettres sont perdues. Boppez avec sagesse !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una sfida extra, BopAway sposta subito ogni lettera toccata nel vassoio delle parole e la sostituisce con una nuova. Se cancelli la parola, quelle lettere vanno perse. Boppa con criterio!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een extra uitdaging verplaatst BopAway elke aangetikte letter meteen naar het woordvak en vervangt die door een nieuwe. Als je het woord wist, zijn die letters verloren. Bop verstandig!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um desafio extra, o BopAway move na hora cada letra tocada para a bandeja de palavras e a substitui por uma nova. Se você limpar a palavra, essas letras são perdidas. Bope com sabedoria!"
          }
        }
      }
    },
