    "Bop to the Top! Non-Stop mode takes away the game timer, so bop as many letters and make as many words as you want!" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bop nach ganz oben! Im Non-Stop-Modus gibt es keinen Timer – bop also so viele Buchstaben und bilde so viele Wörter, wie du willst!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Bopea hasta la cima! El modo Non-Stop quita el temporizador, así que bopea todas las letras y forma todas las palabras que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boppez au sommet ! Le mode Non-Stop supprime le minuteur, alors boppez autant de lettres et formez autant de mots que vous voulez !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boppa fino in cima! La modalità Non-Stop elimina il timer, quindi boppa quante lettere vuoi e crea quante parole vuoi!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bop naar de top! In de Non-Stop-modus is er geen timer, dus bop zoveel letters en maak zoveel woorden als je wilt!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bope até o topo! O modo Non-Stop remove o cronômetro, então bope quantas letras e forme quantas palavras quiser!"
          }
        }
      }
    },
