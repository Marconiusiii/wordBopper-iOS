    "Speaks columns as 1 through 5 and rows as A through E, like \"W, 3A\" for column 3, row A." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt Spalten als 1 bis 5 und Zeilen als A bis E an, etwa „W, 3A“ für Spalte 3, Zeile A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuncia las columnas del 1 al 5 y las filas de la A a la E, como \"W, 3A\" para la columna 3, fila A."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annonce les colonnes de 1 à 5 et les lignes de A à E, comme « W, 3A » pour la colonne 3, ligne A."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuncia le colonne da 1 a 5 e le righe da A a E, come \"W, 3A\" per la colonna 3, riga A."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreekt kolommen uit als 1 t/m 5 en rijen als A t/m E, zoals \"W, 3A\" voor kolom 3, rij A."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fala as colunas de 1 a 5 e as linhas de A a E, como \"W, 3A\" para coluna 3, linha A."
          }
        }
      }
    },
    "Speaks columns as A through E and rows as 1 through 5, like \"G, B3\" for column B, row 3." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt Spalten als A bis E und Zeilen als 1 bis 5 an, etwa „G, B3“ für Spalte B, Zeile 3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuncia las columnas de la A a la E y las filas del 1 al 5, como \"G, B3\" para la columna B, fila 3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annonce les colonnes de A à E et les lignes de 1 à 5, comme « G, B3 » pour la colonne B, ligne 3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuncia le colonne da A a E e le righe da 1 a 5, come \"G, B3\" per la colonna B, riga 3."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreekt kolommen uit als A t/m E en rijen als 1 t/m 5, zoals \"G, B3\" voor kolom B, rij 3."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fala as colunas de A a E e as linhas de 1 a 5, como \"G, B3\" para coluna B, linha 3."
          }
        }
