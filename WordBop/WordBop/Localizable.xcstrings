    "Missing word:\n\nBubble Language: %@\nGame Mode: %@\n\nPlease include the missing word above. If you know the language or regional spelling details, feel free to add those too." : {
      "comment" : "Prefilled email body for reporting a missing word",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlendes Wort:\n\nBlasensprache: %1$@\nSpielmodus: %2$@\n\nBitte gib das fehlende Wort oben an. Wenn du Details zur sprachlichen oder regionalen Schreibweise kennst, füge sie gern hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabra faltante:\n\nIdioma de las burbujas: %1$@\nModo de juego: %2$@\n\nIncluye arriba la palabra que falta. Si conoces detalles de ortografía del idioma o de la región, añádelos también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot manquant :\n\nLangue des bulles : %1$@\nMode de jeu : %2$@\n\nVeuillez indiquer le mot manquant ci-dessus. Si vous connaissez des détails d’orthographe selon la langue ou la région, n’hésitez pas à les ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola mancante:\n\nLingua delle bolle: %1$@\nModalità di gioco: %2$@\n\nIndica sopra la parola mancante. Se conosci dettagli sull’ortografia della lingua o della regione, aggiungili pure."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontbrekend woord:\n\nBellentaal: %1$@\nSpelmodus: %2$@\n\nVermeld het ontbrekende woord hierboven. Als je details kent over de taal- of regiospelling, voeg die dan gerust toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palavra ausente:\n\nIdioma das bolhas: %1$@\nModo de jogo: %2$@\n\nInclua acima a palavra que falta. Se você souber detalhes de ortografia do idioma ou da região, fique à vontade para adicioná-los."
          }
        }
      }
    },
